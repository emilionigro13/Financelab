// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * User Model
 * 
 * Represents a registered user of the FinanceLab platform.
 * Each user can have multiple portfolios and watchlist items.
 */
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password - never store plain text!
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  portfolios Portfolio[]

  @@map("users")
}

/**
 * Portfolio Model
 * 
 * Represents a stock position owned by a user.
 * Tracks shares, purchase price, and date for performance calculations.
 */
model Portfolio {
  id            String   @id @default(uuid())
  userId        String
  ticker        String   // Stock symbol (e.g., AAPL, MSFT)
  shares        Int      // Number of shares owned
  purchasePrice Decimal  @db.Decimal(10, 2) // Price per share at purchase
  purchaseDate  DateTime // When the shares were bought
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}
