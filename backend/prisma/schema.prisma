generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios Portfolio[]
  watchlists Watchlist[]
  alerts     PriceAlert[]
}

model Portfolio {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items        PortfolioItem[]
  transactions Transaction[]
}

model PortfolioItem {
  id          String   @id @default(uuid())
  symbol      String
  companyName String
  shares      Int
  avgCost     Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  symbol      String
  companyName String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Transaction {
  id              String   @id @default(uuid())
  type            String
  symbol          String
  companyName     String
  shares          Int
  price           Decimal  @db.Decimal(12, 4)
  totalAmount     Decimal  @db.Decimal(12, 2)
  realizedPnl     Decimal? @db.Decimal(12, 2)
  remainingShares Int?
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([portfolioId])
  @@index([portfolioId, symbol])
}

model PriceAlert {
  id             String    @id @default(uuid())
  userId         String
  symbol         String
  companyName    String
  alertType      String    @default("PRICE_TARGET")
  condition      String
  targetPrice    Decimal?  @db.Decimal(12, 2)
  referencePrice Decimal?  @db.Decimal(12, 2)
  percentChange  Decimal?  @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  isTriggered    Boolean   @default(false)
  triggeredAt    DateTime?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, isTriggered])
}